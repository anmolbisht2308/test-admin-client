# Server-only: base URL of the api (test-admin-server apps/api). No trailing slash.
# Browsers call /api/* on this site; Next rewrites those requests to API_ORIGIN.
# Local: http://localhost:4000   Prod: https://mockprep-api.onrender.com
API_ORIGIN=http://localhost:4000

# Optional: Google OAuth web client id. Empty hides the "Sign in with Google" button.
# Must also be listed in the api's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Phone OTP login. Set to false while SMS isn't paid for (free setup): the login page then
# shows only "Sign in with Google". Default true.
NEXT_PUBLIC_PHONE_LOGIN=true

# Email-code login (the api sends codes via Brevo, or prints them in dev). Default true.
NEXT_PUBLIC_EMAIL_LOGIN=true

# Public URL of this site (canonical links, JSON-LD). Prod: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
